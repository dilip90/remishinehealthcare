rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in [
          'super-admin',
          'admin',
          'product-manager'
        ];
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isPdf() {
      return request.resource.contentType == 'application/pdf';
    }

    function isAllowedUpload() {
      return isImage() || isPdf();
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && request.resource.size < 2 * 1024 * 1024;
    }

    match /hero-banners/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && request.resource.size < 8 * 1024 * 1024;
    }

    match /documents/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isPdf() && request.resource.size < 10 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
